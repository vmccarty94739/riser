# Supabase project (Project Settings → API Keys). Both values are public by design: they ship
# inside the app, and Row Level Security is what protects each user's data.
# Never put the secret / service_role key in this file or anywhere in the app.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...
